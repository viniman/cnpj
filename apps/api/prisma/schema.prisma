generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["app"]
}

// O schema operacional é modelado aqui, no schema Postgres `app`.
// O schema `receita_staging` permanece bruto, de propriedade de
// infra/postgres/migrations, e é lido via SQL parametrizado a partir do
// NestJS (ver CompaniesService), nao remodelado pelo Prisma.
// Ver docs/NEXT_ARCHITECTURE_LEDGER.md para a decisao de separacao de schemas.

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("organizations")
  @@schema("app")
}

model User {
  id             Int          @id @default(autoincrement())
  organizationId Int          @map("org_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String       @unique
  role           String       @default("admin")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("users")
  @@schema("app")
}

// Sem escopo por organizacao ainda: sem autenticacao neste MVP interno,
// listas sao globais. Escopo por organizationId entra junto com auth.
model List {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  companies   ListCompany[]
  campaigns   Campaign[]

  @@map("lists")
  @@schema("app")
}

// Snapshot dos campos de exibicao no momento em que a empresa foi
// adicionada a lista, para nao depender de novo join com
// receita_staging a cada visualizacao (que pode ser lento por cache
// frio, ver docs/ARCHITECTURE.md).
model ListCompany {
  id                 Int      @id @default(autoincrement())
  listId             Int      @map("list_id")
  list               List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  cnpjBasico         String   @map("cnpj_basico")
  cnpjOrdem          String   @map("cnpj_ordem")
  cnpjDv             String   @map("cnpj_dv")
  razaoSocial        String   @map("razao_social")
  nomeFantasia       String?  @map("nome_fantasia")
  situacaoCadastral  String?  @map("situacao_cadastral")
  uf                 String?
  municipioNome      String?  @map("municipio_nome")
  cnaeDescricao      String?  @map("cnae_descricao")
  correioEletronico  String?  @map("correio_eletronico")
  addedAt            DateTime @default(now()) @map("added_at")

  @@unique([listId, cnpjBasico, cnpjOrdem, cnpjDv])
  @@map("list_companies")
  @@schema("app")
}

// Senha SMTP fica criptografada (AES-256-GCM, ver crypto.util.ts) e a
// API nunca retorna o texto puro. Limite diario e atraso entre envios
// mapeados a partir da tela "Contas de e-mail" do Snov.io (ADR-054).
model EmailAccount {
  id                    Int      @id @default(autoincrement())
  name                  String
  fromName              String   @map("from_name")
  fromEmail             String   @map("from_email")
  smtpHost              String   @map("smtp_host")
  smtpPort              Int      @map("smtp_port")
  smtpSecure            Boolean  @default(true) @map("smtp_secure")
  smtpUser              String   @map("smtp_user")
  smtpPasswordEncrypted String   @map("smtp_password_encrypted")
  dailyLimit            Int      @default(100) @map("daily_limit")
  limitResetTimezone    String   @default("UTC") @map("limit_reset_timezone")
  delayMode             String   @default("random") @map("delay_mode")
  delayFixedSeconds     Int?     @map("delay_fixed_seconds")
  delayMinSeconds       Int?     @map("delay_min_seconds")
  delayMaxSeconds       Int?     @map("delay_max_seconds")
  lastSentAt            DateTime? @map("last_sent_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  campaigns             Campaign[]

  @@map("email_accounts")
  @@schema("app")
}

// Nasce em draft; so envia de verdade quando o usuario ativa
// explicitamente (nunca automatico). Ver CampaignSenderService para o
// motor de envio e ADR-056 em docs/DECISIONS.md para as decisoes de
// throttle/supressao.
model Campaign {
  id             Int      @id @default(autoincrement())
  name           String
  listId         Int      @map("list_id")
  list           List     @relation(fields: [listId], references: [id])
  emailAccountId Int      @map("email_account_id")
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id])
  subject        String
  bodyHtml       String   @map("body_html")
  status         String   @default("draft")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  recipients     CampaignRecipient[]

  @@map("campaigns")
  @@schema("app")
}

// Snapshot dos campos de exibicao/e-mail no momento da criacao da
// campanha, na mesma logica de ListCompany. Empresas sem e-mail entram
// como skipped_no_email e nunca sao processadas pelo worker.
model CampaignRecipient {
  id            Int      @id @default(autoincrement())
  campaignId    Int      @map("campaign_id")
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  listCompanyId Int      @map("list_company_id")
  razaoSocial   String   @map("razao_social")
  nomeFantasia  String?  @map("nome_fantasia")
  municipioNome String?  @map("municipio_nome")
  email         String?
  status        String   @default("pending")
  sentAt        DateTime? @map("sent_at")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("campaign_recipients")
  @@schema("app")
}

// Checada antes de qualquer envio (ADR-054: supressao/opt-out nao pode
// ser enfraquecida por nenhuma camada nova). Alimentada pelo link de
// descadastro (GET /unsubscribe) e, futuramente, por bounces.
model SuppressionEntry {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  reason    String   @default("unsubscribed")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("suppression_entries")
  @@schema("app")
}
